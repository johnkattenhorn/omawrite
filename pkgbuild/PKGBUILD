# Maintainer: John Kattenhorn <john.kattenhorn.personal@gmail.com>
# Upstream maintainer: David Heinemeier Hansson <david@hey.com>
#
# Builds the working tree, not a release tarball, so what lands in /usr/bin is
# whatever is checked out. pkgver carries the commit count and sha for that
# reason: `pacman -Q omawrite` should say which build is installed.

pkgname=omawrite
pkgver=0.5.0.r98.ge04db39
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick (custom fork: tabs, preview, sidebar, image paste, D-Bus CLI)'
arch=('x86_64')
url='https://github.com/johnkattenhorn/omawrite'
license=('MIT')
install='omawrite.install'
depends=('qt6-base>=6.5' 'qt6-declarative>=6.5' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base>=6.5' 'qt6-declarative>=6.5')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omawrite "$pkgdir/usr/bin/omawrite"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omawrite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawrite.svg"
  /usr/bin/install -Dm644 "$startdir/omawrite.desktop" "$pkgdir/usr/share/applications/omawrite.desktop"
}
